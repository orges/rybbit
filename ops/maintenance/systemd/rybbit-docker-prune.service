[Unit]
Description=Prune dangling Docker images left behind by Rybbit builds
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Dangling (untagged) images only: the version now running and any tagged
# rollback target are kept. A successful build tags its own image, so anything
# dangling here is a leftover layer rather than something worth restoring.
ExecStart=/usr/bin/docker image prune --force
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7